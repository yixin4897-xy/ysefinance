{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ysefinance:aesm:provenance-manifest:0.1.0",
  "title": "AESM V4.1 research provenance manifest V0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^e(04|12)-[ab]-[a-f0-9]{64}$"
    },
    "indicator": {
      "type": "string",
      "enum": [
        "E04",
        "E12"
      ]
    },
    "methodological_variant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "candidate_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "const": "CANDIDATE_ONLY_PENDING_VALIDATION"
        },
        "transformations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name",
        "candidate_version",
        "status",
        "transformations"
      ],
      "additionalProperties": false
    },
    "historical_classification": {
      "type": "string",
      "const": "latest_revised_data_research"
    },
    "point_in_time_eligible": {
      "type": "boolean",
      "const": false
    },
    "identity_basis": {
      "type": "string",
      "const": "SHA256_CANONICAL_JSON_EXCLUDING_MANIFEST_ID"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "ABS",
              "RBA"
            ]
          },
          "series_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_filename": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_vintage_id": {
            "type": "string",
            "pattern": "^(abs|rba)-sha256-[a-f0-9]{64}$"
          },
          "vintage_identity_basis": {
            "type": "string",
            "const": "CONTENT_ADDRESSED_BYTES_NOT_FIRST_RELEASE_VINTAGE"
          },
          "official_source_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "official_source_url_status": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "RECORDED_PRIOR_SOURCE_REVIEW"
            ]
          },
          "official_reference_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_local_path": {
            "type": "string",
            "minLength": 1
          },
          "archive_relative_path": {
            "type": "string",
            "pattern": "^research-inputs/vintage-archive/sha256/[a-f0-9]{64}\\.xlsx$"
          },
          "archive_status": {
            "type": "string",
            "const": "NOT_ARCHIVED_BY_PILOT"
          },
          "release": {
            "type": "object",
            "properties": {
              "period": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "date_status": {
                "type": "string",
                "enum": [
                  "UNKNOWN",
                  "RECORDED_PRIOR_SOURCE_REVIEW"
                ]
              },
              "retrieved_at_utc": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retrieval_status": {
                "type": "string",
                "enum": [
                  "UNKNOWN",
                  "EVIDENCED"
                ]
              },
              "availability_timestamp_utc": {
                "type": "null"
              }
            },
            "required": [
              "period",
              "date",
              "date_status",
              "retrieved_at_utc",
              "retrieval_status",
              "availability_timestamp_utc"
            ],
            "additionalProperties": false
          },
          "measurement": {
            "type": "object",
            "properties": {
              "frequency": {
                "type": "string",
                "enum": [
                  "quarterly",
                  "monthly"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "seasonal_adjustment": {
                "type": "string",
                "minLength": 1
              },
              "data_type": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "sheet": {
                "type": "string",
                "minLength": 1
              },
              "metadata_range": {
                "type": "string",
                "minLength": 1
              },
              "observation_date_convention": {
                "type": "string",
                "const": "ABS_REFERENCE_MONTH_FIRST_DAY_NOT_PUBLICATION_DATE"
              },
              "reference_year": {
                "type": "object",
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "UNKNOWN",
                      "NOT_APPLICABLE_TO_ANNUAL_RATE"
                    ]
                  },
                  "official_release_reference_year": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "applies_to_this_snapshot": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "value",
                  "status",
                  "official_release_reference_year",
                  "applies_to_this_snapshot"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "frequency",
              "unit",
              "seasonal_adjustment",
              "data_type",
              "table",
              "sheet",
              "metadata_range",
              "observation_date_convention",
              "reference_year"
            ],
            "additionalProperties": false
          },
          "coverage": {
            "type": "object",
            "properties": {
              "first_period": {
                "type": "string",
                "minLength": 1
              },
              "last_period": {
                "type": "string",
                "minLength": 1
              },
              "observation_count": {
                "type": "integer",
                "minimum": 1
              },
              "grid_count": {
                "type": "integer",
                "minimum": 1
              },
              "leading_missing_count": {
                "type": "integer",
                "minimum": 0
              },
              "trailing_missing_count": {
                "type": "integer",
                "minimum": 0
              },
              "internal_missing_count": {
                "type": "integer",
                "minimum": 0
              },
              "excluded_blank_periods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "first_period",
              "last_period",
              "observation_count",
              "grid_count",
              "leading_missing_count",
              "trailing_missing_count",
              "internal_missing_count",
              "excluded_blank_periods"
            ],
            "additionalProperties": false
          },
          "validation": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "const": "LOCAL_HASH_METADATA_COVERAGE_CHECKED"
              },
              "official_authenticity": {
                "type": "string",
                "enum": [
                  "UNKNOWN",
                  "PRIOR_REVIEW_RECORDED_NOT_REVERIFIED"
                ]
              },
              "fresh_official_download_verified": {
                "type": "boolean",
                "const": false
              },
              "evidence_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "state",
              "official_authenticity",
              "fresh_official_download_verified",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "role",
          "provider",
          "series_id",
          "description",
          "source_filename",
          "source_sha256",
          "source_vintage_id",
          "vintage_identity_basis",
          "official_source_url",
          "official_source_url_status",
          "official_reference_url",
          "source_local_path",
          "archive_relative_path",
          "archive_status",
          "release",
          "measurement",
          "coverage",
          "validation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "output_coverage": {
      "type": "object",
      "properties": {
        "first_period": {
          "type": "string",
          "minLength": 1
        },
        "last_period": {
          "type": "string",
          "minLength": 1
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "frequency": {
          "type": "string",
          "enum": [
            "quarterly",
            "monthly"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "first_period",
        "last_period",
        "observation_count",
        "frequency",
        "unit",
        "meaning"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hash_basis": {
            "type": "string",
            "const": "UTF8_TEXT_LF_NORMALIZED"
          }
        },
        "required": [
          "path",
          "sha256",
          "hash_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "evidence_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "validation_state": {
      "type": "string",
      "const": "LOCAL_SNAPSHOT_CHECKED_NOT_PUBLICATION_APPROVAL"
    },
    "approval": {
      "type": "object",
      "properties": {
        "indicator_definition_approved": {
          "type": "boolean",
          "const": false
        },
        "publication_approved": {
          "type": "boolean",
          "const": false
        },
        "production_pinned": {
          "type": "boolean",
          "const": false
        },
        "scoring_approved": {
          "type": "boolean",
          "const": false
        },
        "weights_approved": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "indicator_definition_approved",
        "publication_approved",
        "production_pinned",
        "scoring_approved",
        "weights_approved"
      ],
      "additionalProperties": false
    },
    "composite_release_statuses": {
      "type": "object",
      "properties": {
        "AEHI": {
          "type": "string",
          "const": "HOLD"
        },
        "AESI": {
          "type": "string",
          "const": "HOLD"
        },
        "ASFI": {
          "type": "string",
          "const": "HOLD"
        }
      },
      "required": [
        "AEHI",
        "AESI",
        "ASFI"
      ],
      "additionalProperties": false
    },
    "composite_scores": {
      "type": "object",
      "properties": {
        "AEHI": {
          "type": "null"
        },
        "AESI": {
          "type": "null"
        },
        "ASFI": {
          "type": "null"
        }
      },
      "required": [
        "AEHI",
        "AESI",
        "ASFI"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "indicator",
    "methodological_variant",
    "historical_classification",
    "point_in_time_eligible",
    "identity_basis",
    "sources",
    "output_coverage",
    "evidence",
    "evidence_commit",
    "validation_state",
    "approval",
    "composite_release_statuses",
    "composite_scores",
    "limitations"
  ],
  "additionalProperties": false
}
